# ResumeLoops — Environment Configuration
# Copy this file to .env.local to configure your local development environment.
# DO NOT commit .env.local or any real secrets to version control.

# Google Gemini API (For AI tailoring & ATS semantic optimization)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Application Environment
NODE_ENV=development
