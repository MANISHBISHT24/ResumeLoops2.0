# ResumeLoops — Environment Configuration Example
# Copy this file to .env.local to configure your local development environment.
# DO NOT commit .env.local or any real secrets to version control.

# ==============================================================================
# Supabase Configuration (Phase 3J: Authentication & PostgreSQL Database)
# ==============================================================================
# 1. Create a Supabase project at: https://supabase.com/dashboard
# 2. Go to Project Settings -> API.
# 3. Copy the Project URL and Publishable/Anon Key into your .env.local file:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here
# Optional alias supported for standard anon key naming:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here

# ==============================================================================
# OpenAI API Configuration (Server-Side Only for AI Resume Rewriter)
# ==============================================================================
# Obtain a key from the OpenAI Developer Platform: https://platform.openai.com/api-keys
# Uses the official OpenAI Responses API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Application Environment
# ==============================================================================
NODE_ENV=development
